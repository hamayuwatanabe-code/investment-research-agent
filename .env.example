# ---------------------------------------------------------------------------
# investment-research-agent  --  example environment file
# Copy to .env (which is gitignored) and fill in.  NEVER commit real keys.
# Every variable is OPTIONAL: the system runs with none of them set, and simply
# reports the resulting gaps as INSUFFICIENT_EVIDENCE / INCOMPLETE RESEARCH.
# ---------------------------------------------------------------------------

# SEC EDGAR requires a descriptive User-Agent with a contact address.
# https://www.sec.gov/os/webmaster-faq#developers
IRA_SEC_USER_AGENT="investment-research-agent your.name@example.com"

# Optional LLM provider, used ONLY for narrative synthesis of already-verified
# facts.  The deterministic core (kill gate, capital math, valuation,
# contradiction detection) never calls an LLM.
IRA_ANTHROPIC_API_KEY=

# Optional web-search provider for Tier 3-5 discovery + Kill Agent queries.
# provider: none | tavily | brave
IRA_SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional market-data provider for Agent 12 (microstructure).
# provider: none | polygon
IRA_MARKET_PROVIDER=none
POLYGON_API_KEY=

# Runtime knobs
IRA_DB_PATH=data/research.db
IRA_CACHE_DIR=data/cache
IRA_LOG_DIR=logs
IRA_HTTP_TIMEOUT=30
IRA_HTTP_MAX_RETRIES=4
IRA_RATE_LIMIT_RPS=5
